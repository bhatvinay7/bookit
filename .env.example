# -------------------------------------------------------------
# Kubernetes Sealed Secrets Environment Example
# -------------------------------------------------------------
# These variables match the GitHub Actions Secrets that get 
# encrypted into SealedSecrets by the CI/CD pipeline.
# Copy this file to `.env` for local development.

# Database & Cache Connections
DATABASE_URL=postgres://user:password@localhost:5432/bookit
MONGO_DB_URL=mongodb://root:password@localhost:27017/bookit
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# External Services & Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Cloudflare R2 (S3-Compatible Storage)
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_key
NEXT_PUBLIC_R2_PUBLIC_URL=https://your-r2-public-url.example.com

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Internal gRPC routing
GRPC_SERVER_URL=localhost:50051

# Security & Encryption
INVITATION_ENCRYPTION_KEY=your_random_32_byte_encryption_key_here

# Frontend / Public Config (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:8080
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_USE_REMOTE_STOCKFISH=false
CLIENT_URL=http://localhost:3000

# SMTP / Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@chesscounty.life

# Postgres Logical Replication Setup (CDC)
REPLICATION_URL=postgres://repl_user:password@localhost:5432/bookit
SLOT_NAME=bookit_slot
PUBLICATION=bookit_publication
