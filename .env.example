# -------------------------------------------------------------
# Kubernetes Sealed Secrets Environment Example
# -------------------------------------------------------------
# These variables match the GitHub Actions Secrets that get 
# encrypted into SealedSecrets by the CI/CD pipeline.
# Copy this file to `.env` for local development.

# -------------------------------------------------------------
# Deployment Toggles & Multi-Region
# -------------------------------------------------------------
# Enables ArgoCD deployment to multiple regional clusters
ENABLE_MULTI_REGION=false

# Regional cluster targets (must match your kube-contexts if multi-region is true)
PRIMARY_REGION=us-east
SECONDARY_REGION=eu-west

# Database Deployment Target: 
# true = Use external cloud URLs for Postgres & MongoDB (Custom local deployments are skipped)
# false = Provision custom in-cluster StatefulSets for Postgres & MongoDB (with automated S3 backups)
# Note: Redis and RabbitMQ will ALWAYS use custom in-cluster deployments.
USE_CLOUD_PROVIDER=true

# Database & Cache Connections
DATABASE_URL=postgresql://user:password@localhost:5432/bookit
MONGODB_URL=mongodb://root:password@localhost:27017/bookit
MONGODB_DB=bookit
REDIS_URL=redis://localhost:6379
REDIS_MODE=single
RABBITMQ_URL=amqp://guest:guest@localhost:5672
ELASTICSEARCH_URL=http://localhost:9200

# External Services & Cloudinary

# Cloudflare R2 (S3-Compatible Storage)
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_key
CLOUDFLARE_R2_BUCKET=your_bucket
CLOUDFLARE_R2_PUBLIC_URL=https://thepipe.shop

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Internal service routing
GRPC_SERVER_URL=http://127.0.0.1:50052
GATEWAY_KEEPER_GRPC_URL=http://127.0.0.1:50052
HTTP_SERVER_URL=http://127.0.0.1:8082
SEARCH_SERVER_GRPC_URL=http://127.0.0.1:50051

# Local bindings and runtime
GATEWAY_KEEPER_ADDR=0.0.0.0:8080
GATEWAY_KEEPER_GRPC_ADDR=0.0.0.0:50052
HTTP_PORT=8082
WS_PORT=8081
SEARCH_HTTP_PORT=8084
SEARCH_GRPC_PORT=50051
APP_MODE=dev
BOOKIT_ENVIRONMENT=local
BOOKIT_REGION=local
RUST_LOG=info
CORS_ALLOWED_ORIGINS=http://localhost:3000
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Security & Encryption
INVITATION_ENCRYPTION_KEY=your_random_32_byte_encryption_key_here

# Frontend / Public Config (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8081
NEXT_PUBLIC_SEARCH_API_URL=http://localhost:8080
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_key

# SMTP / Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@bookit4u.shop

# Notification worker Gmail SMTP
GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
SUPPORT_EMAIL=support@example.com

# Postgres Logical Replication Setup (CDC)
REPLICATION_URL=postgres://repl_user:password@localhost:5432/bookit
SLOT_NAME=bookit_slot
PUBLICATION=bookit_publication
