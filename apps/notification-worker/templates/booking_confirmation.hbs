<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light">
  <title>Booking confirmed</title>
  <style>
    body{margin:0!important;padding:0!important;background:#f3f4f6;font-family:Arial,Helvetica,sans-serif}table{border-collapse:collapse}a{color:#4338ca}
    @media only screen and (max-width:620px){.shell{width:100%!important}.content{padding:24px 20px!important}.summary{display:block!important;width:auto!important;border-right:0!important}.button{display:block!important;text-align:center!important}}
  </style>
</head>
<body>
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent">Your BookIt ticket is ready. Order {{order_id}} is confirmed.</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;background:#f3f4f6"><tr><td align="center" style="padding:32px 12px">
    <table role="presentation" class="shell" width="600" cellpadding="0" cellspacing="0" style="width:600px;max-width:600px;background:#fff;border-radius:18px;overflow:hidden;box-shadow:0 8px 30px rgba(15,23,42,.08)">
      <tr><td style="padding:28px 36px;background:#111827;color:#fff"><div style="font-size:26px;font-weight:800">Book<span style="color:#fbbf24">It</span></div><div style="margin-top:6px;font-size:13px;color:#cbd5e1">Tickets made simple</div></td></tr>
      <tr><td class="content" style="padding:36px">
        <div style="display:inline-block;padding:7px 12px;border-radius:999px;background:#dcfce7;color:#166534;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.4px">Booking confirmed</div>
        <h1 style="margin:18px 0 10px;color:#111827;font-size:30px;line-height:1.2">You’re all set.</h1>
        <p style="margin:0 0 26px;color:#4b5563;font-size:16px;line-height:1.65">Your payment was successful and your tickets are ready. Keep this email handy when you arrive.</p>
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;background:#f8fafc;border:1px solid #e5e7eb;border-radius:14px">
          <tr>
            <td class="summary" width="50%" style="padding:18px 20px;border-right:1px solid #e5e7eb;border-bottom:1px solid #e5e7eb"><div style="color:#6b7280;font-size:11px;font-weight:700;text-transform:uppercase">Order</div><div style="margin-top:6px;color:#111827;font-size:14px;font-weight:700;word-break:break-all">{{order_id}}</div></td>
            <td class="summary" width="50%" style="padding:18px 20px;border-bottom:1px solid #e5e7eb"><div style="color:#6b7280;font-size:11px;font-weight:700;text-transform:uppercase">Total paid</div><div style="margin-top:6px;color:#111827;font-size:18px;font-weight:800">₹{{amount}}</div></td>
          </tr>
          <tr>
            <td class="summary" width="50%" style="padding:18px 20px;border-right:1px solid #e5e7eb"><div style="color:#6b7280;font-size:11px;font-weight:700;text-transform:uppercase">Venue</div><div style="margin-top:6px;color:#111827;font-size:14px;font-weight:700">{{venue}}</div></td>
            <td class="summary" width="50%" style="padding:18px 20px"><div style="color:#6b7280;font-size:11px;font-weight:700;text-transform:uppercase">Show time</div><div style="margin-top:6px;color:#111827;font-size:14px;font-weight:700">{{show_time}}</div></td>
          </tr>
        </table>
        <h2 style="margin:28px 0 12px;color:#111827;font-size:17px">Your seats ({{seat_count}})</h2>
        <div style="margin-bottom:28px">{{#each seats}}<span style="display:inline-block;margin:0 7px 7px 0;padding:8px 12px;border-radius:8px;background:#eef2ff;color:#3730a3;font-size:13px;font-weight:700">Seat {{this}}</span>{{/each}}</div>
        <a href="{{ticket_url}}" class="button" style="display:inline-block;padding:14px 24px;border-radius:10px;background:#4f46e5;color:#fff;text-decoration:none;font-size:15px;font-weight:700">Download your ticket</a>
        <p style="margin:24px 0 0;color:#6b7280;font-size:13px;line-height:1.6">Present the PDF ticket at entry. Please do not share its QR code publicly.</p>
      </td></tr>
      <tr><td style="padding:22px 36px;background:#f8fafc;border-top:1px solid #e5e7eb;color:#6b7280;font-size:12px;line-height:1.6">Need help? Email <a href="mailto:{{support_email}}" style="text-decoration:none">{{support_email}}</a>.<br>This transactional email was sent because a booking was completed on BookIt.</td></tr>
    </table>
  </td></tr></table>
</body>
</html>
